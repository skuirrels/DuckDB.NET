<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <SonarQubeExclude>true</SonarQubeExclude>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <BuildType>Full</BuildType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\keyPair.snk</AssemblyOriginatorKeyFile>
    <!-- BenchmarkDotNet finds the project file by the assembly name, so the assembly is named after this file.
         Directory.Build.props would otherwise name it DuckDB.NET.Benchmarks. -->
    <AssemblyName>Benchmarks</AssemblyName>
    <RootNamespace>DuckDB.NET.Benchmarks</RootNamespace>
    <!-- /p:UseNuGet=true benchmarks a published package instead of the code in this repository (micro suite only).
         The package ID defaults to upstream's DuckDB.NET.Data.Full; pass /p:DuckDBNuGetId=Skuirrels.DuckDB.NET.Data.Full
         to benchmark a fork release. -->
    <DuckDBNuGetId Condition="'$(DuckDBNuGetId)' == ''">DuckDB.NET.Data.Full</DuckDBNuGetId>
    <DuckDBNuGetVersion Condition="'$(DuckDBNuGetVersion)' == ''">2.0.0-preview.1</DuckDBNuGetVersion>
    <DefineConstants Condition="'$(UseNuGet)' == 'true'">$(DefineConstants);DUCKDB_NET_PACKAGE</DefineConstants>
    <!-- Packages that are not on nuget.org, such as a CI build, can be put in the packages folder next to this file.
         The folder is ignored by git. -->
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)packages')">$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGet)' != 'true'">
    <ProjectReference Include="..\DuckDB.NET.Data\Data.csproj" />
    <ProjectReference Include="..\DuckDB.NET.Bindings\Bindings.csproj" Properties="BuildType=Full" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGet)' == 'true'">
    <PackageReference Include="$(DuckDBNuGetId)" Version="$(DuckDBNuGetVersion)" />
  </ItemGroup>

  <!-- The realistic driver-comparison suite uses fork-only APIs and runs in-process against this repository only. -->
  <ItemGroup Condition="'$(UseNuGet)' == 'true'">
    <Compile Remove="AppenderBenchmark.cs;ListSourceAppenderBenchmark.cs;ListMaterializationBenchmark.cs;PreparedCommandBenchmark.cs;PreparedCommandWorkload.cs;RealisticBenchmarks.cs;RealisticWorkload.cs" />
  </ItemGroup>

  <!-- Copy the already-downloaded native DuckDB library into the benchmark output so it can be
       loaded via runtimes/{rid}/native/. The NuGet package brings its own. -->
  <ItemGroup Condition="'$(UseNuGet)' != 'true'">
    <None Include="..\DuckDB.NET.Bindings\obj\runtimes\**\*.dll;..\DuckDB.NET.Bindings\obj\runtimes\**\*.so;..\DuckDB.NET.Bindings\obj\runtimes\**\*.dylib;">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\%(RecursiveDir)\%(FileName)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
