<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <AssemblyName>DuckDB.EFCoreProvider.1_9_0.Benchmarks</AssemblyName>
    <RootNamespace>DuckDB.NET.Benchmarks</RootNamespace>
    <DefineConstants>$(DefineConstants);DUCKDB_NET_BASELINE_1_5_3;DUCKDB_EFCORE_PROVIDER_1_9_0</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
    <PackageReference Include="DuckDB.EFCoreProvider" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DuckDB.NET.Benchmarks\NativeLibraryLoader.cs" Link="NativeLibraryLoader.cs" />
    <Compile Include="..\DuckDB.NET.Benchmarks\PreparedCommandBenchmark.cs" Link="PreparedCommandBenchmark.cs" />
    <Compile Include="..\DuckDB.NET.Benchmarks\PreparedCommandWorkload.cs" Link="PreparedCommandWorkload.cs" />
    <Compile Include="..\DuckDB.NET.Benchmarks\RealisticBenchmarks.cs" Link="RealisticBenchmarks.cs" />
    <Compile Include="..\DuckDB.NET.Benchmarks\RealisticWorkload.cs" Link="RealisticWorkload.cs" />
    <Compile Include="..\DuckDB.NET.Benchmarks\Program.cs" Link="Program.cs" />
  </ItemGroup>

</Project>
